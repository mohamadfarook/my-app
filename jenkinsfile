pipeline {
    agent any

    environment {
        IMAGE_NAME = "myapp"
        IMAGE_TAG = "latest"
        DOCKER_REGISTRY = "https://app.docker.com/accounts/dockerpathan007"  // optional
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project...'
                // Example: Compile or build step (adjust for your tech stack)
                sh './build.sh' // or mvn clean install, npm run build, etc.
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Docker Push') {
            when {
                expression { env.DOCKER_REGISTRY != "" }
            }
            steps {
                script {
                    docker.withRegistry("https://app.docker.com/accounts/dockerpathan007}", 'docker-credentials-id') {
                        dockerImage.push()
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
        }
        success {
            echo 'Build completed successfully.'
        }
        failure {
            echo 'Build failed.'
        }
    }
}

